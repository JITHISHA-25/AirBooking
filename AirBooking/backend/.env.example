DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite is used when POSTGRES_DB is empty.
# POSTGRES_DB=airbooking
# POSTGRES_USER=airbooking
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# true executes email tasks locally. Set false with Redis and a worker.
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=AirBooking <noreply@example.com>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
AIRLABS_API_KEY=
# Food ordering and voluntary food cancellation close this many hours before departure.
FOOD_ORDER_CUTOFF_HOURS=2
